// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  dateGmt       DateTime @default(now()) @map("date_gmt")
  modified      DateTime @default(now())
  modifiedGmt   DateTime @default(now()) @map("modified_gmt")
  slug          String   @unique
  status        String   @default("publish")
  title         String
  content       String   @db.Text
  excerpt       String?  @db.Text
  author        Int
  authorRef     Author?  @relation(fields: [authorRefId], references: [id])
  authorRefId   Int?     @map("author_ref_id")
  featuredMedia String?  @map("featured_media")
  domain        String
  categories    DomainCategories[]
  tags          Tag[]

  @@map("posts")
  @@index([authorRefId])
}

model Author {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String
  bio         String?  @db.Text
  avatar      String?
  email       String?
  twitter     String?
  linkedin    String?
  website     String?
  credentials String?  @db.Text
  jobTitle    String?  @map("job_title")
  domain      String
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  posts       Post[]

  @@unique([domain, slug])
  @@map("authors")
}

model DomainCategories {
  id          Int      @id @default(autoincrement())
  domain      String
  name        String
  slug        String
  isActive    Boolean  @default(true) @map("is_active")
  posts       Post[]

  @@unique([domain, slug])
  @@map("domain_categories")
}

model Tag {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?  @db.Text
  domain      String
  posts       Post[]

  @@map("tags")
}
